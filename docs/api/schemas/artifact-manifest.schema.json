{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowcraft.local/schemas/artifact-manifest.schema.json",
  "title": "Import Wizard Artifact Manifest",
  "description": "Compilation outputs and downloadable artifacts for selected export targets.",
  "type": "object",
  "required": ["sessionId", "compiledAt", "targets", "artifacts"],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "compiledAt": {
      "type": "string",
      "format": "date-time"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "mermaid",
          "bpmn",
          "processmap_v1",
          "json",
          "csv",
          "pdf"
        ]
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "targetReports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/targetReport"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["artifactId", "target", "mimeType", "filename", "downloadUrl"],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "enum": [
            "mermaid",
            "bpmn",
            "processmap_v1",
            "json",
            "csv",
            "pdf"
          ]
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri"
        },
        "checksumSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "targetReport": {
      "type": "object",
      "required": ["target", "validationStatus"],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "mermaid",
            "bpmn",
            "processmap_v1",
            "json",
            "csv",
            "pdf"
          ]
        },
        "validationStatus": {
          "type": "string",
          "enum": ["ok", "warning", "error"]
        },
        "lossReport": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": ["info", "warning", "critical"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
